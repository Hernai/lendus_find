# =============================================================================
# Variables que Vite inyecta en el build de producción.
# Renombrar a `.env.production` en el servidor/CI antes de `npm run build`
# (o `npm run tenant:build`). NO commitear `.env.production` real.
# =============================================================================

# Backend HTTP. Único host compartido por todos los tenants — el slug viaja
# en el header X-Tenant-ID que el interceptor agrega automáticamente.
VITE_API_URL=https://apifind.lendus.app/api

# Dominio público del sitio institucional.
VITE_APP_URL=https://lendus.app

# Reverb WebSocket — mismo host que el backend Laravel (en prod TLS).
VITE_REVERB_APP_KEY=<obtener del backend .env (REVERB_APP_KEY)>
VITE_REVERB_HOST=apifind.lendus.app
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# NO setear VITE_TENANT_ID en producción: cada bundle se sirve desde el
# subdominio del tenant (moneycapital.lendus.app, finatea.lendus.app, …)
# y `detectTenantSlug()` lo resuelve a runtime.
