# =============================================================================
# Defaults para dev local web (npm run dev). Renómbralo a `.env` o copia los
# valores. Para overrides locales que NO van a git, usa `.env.local`.
# =============================================================================

# Backend HTTP — host único en producción (arquitectura B).
VITE_API_URL=http://localhost:8000/api

# Tenant por defecto cuando no hay subdominio (entrás en http://localhost:5173).
# En producción NO se setea: el tenant se resuelve por subdominio
# (moneycapital.lendus.app → 'moneycapital') y lo manda el interceptor en
# el header X-Tenant-ID.
VITE_TENANT_ID=demo

# Branding / UI base.
VITE_APP_NAME=LendusFind
VITE_APP_URL=http://localhost:5173

# Reverb WebSocket — mismo host que el backend en prod.
VITE_REVERB_APP_KEY=rli83jph063g9yk16wsl
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8081
VITE_REVERB_SCHEME=http

# -----------------------------------------------------------------------------
# Notas para otros entornos
# -----------------------------------------------------------------------------
# Emulador Android (necesita 10.0.2.2 para llegar al host Mac):
#   crear `.env.local` con
#     VITE_API_URL=http://10.0.2.2:8000/api
#     VITE_REVERB_HOST=10.0.2.2
#     VITE_REVERB_PORT=8080
#
# Producción (deploy del frontend en *.lendus.app):
#   ver `.env.production.example`.
