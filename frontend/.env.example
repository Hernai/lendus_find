# API Configuration
VITE_API_URL=http://localhost:8000/api

# Tenant Configuration
VITE_TENANT_ID=demo

# App Configuration
VITE_APP_NAME=LendusFind
VITE_APP_URL=http://localhost:5173

# Producción (frontend desplegado en moneycapital.lendus.app, finatea.lendus.app,
# demo.lendus.app, …). El backend vive en apifind.lendus.app y el tenant se
# resuelve por el subdominio del frontend → el interceptor agrega X-Tenant-ID
# automáticamente, por lo que VITE_TENANT_ID NO se setea en prod.
# VITE_API_URL=https://apifind.lendus.app/api
# VITE_APP_URL=https://lendus.app
