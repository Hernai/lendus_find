# =============================================================================
# Variables de produccion para Vite (inyectadas en build time).
#
# Todas las VITE_* terminan en el bundle servido al browser, asi que
# SOLO valores publicos:
#   - URL del backend (visible en cada request del browser)
#   - REVERB_APP_KEY (publico por diseno, equivalente a una "publishable
#     key" — Reverb autentica canales privados con tokens del backend, no
#     con esta key)
#
# Este archivo SI se commitea para que Jenkins pueda buildear sin requerir
# inyeccion de env vars adicionales. Si en el futuro alguna VITE_* es
# sensible (ej. una API key de un servicio externo), moverla a credentials
# de Jenkins y dejar este archivo solo con los publicos.
# =============================================================================

# Backend HTTP. Unico host compartido por todos los tenants — el slug viaja
# en el header X-Tenant-ID que el interceptor agrega automaticamente.
VITE_API_URL=https://apifind.lendus.app/api

# Dominio publico del sitio institucional.
VITE_APP_URL=https://lendus.app

# Reverb WebSocket — mismo host que el backend Laravel (en prod TLS).
# REVERB_APP_KEY es el del tenant actual; ver backend `.env` REVERB_APP_KEY.
VITE_REVERB_APP_KEY=rli83jph063g9yk16wsl
VITE_REVERB_HOST=apifind.lendus.app
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
